{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "scan-ui-repo",
			"type": "shell",
			"command": "find . -maxdepth 4 -mindepth 1 | sort"
		},
		{
			"label": "install-and-build-ui",
			"type": "shell",
			"command": "npm install && npm run build"
		},
		{
			"label": "ui-build-status",
			"type": "shell",
			"command": "npm install --no-audit --no-fund && npm run build && echo 'BUILD_OK'"
		}
	]
}